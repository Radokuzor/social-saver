{
  "expo": {
    "name": "social-saver",
    "slug": "social-saver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "socialsaver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf2f8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fourthwatchtech.socialSaver"
    },
    "android": {
      "package": "com.fourthwatchtech.socialsaver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fdf2f8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to save content."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
